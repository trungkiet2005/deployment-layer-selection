__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/

# LaTeX build artefacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/*.spl
paper/*.run.xml

results/figure_log*.txt

# JAAMAS build artefacts (paper-jaamas/ is generated by scripts/build_jaamas.py).
# build.py writes intermediates to paper-jaamas/build/, which the build/ rule at
# the top already covers; the patterns below catch a pdflatex run started by
# hand in the package directory.  main.bbl is listed because it is generated,
# even though it is one of the files uploaded to the journal.
paper-jaamas/*.aux
paper-jaamas/*.bbl
paper-jaamas/*.blg
paper-jaamas/*.log
paper-jaamas/*.out
paper-jaamas/*.fls
paper-jaamas/*.fdb_latexmk
paper-jaamas/*.toc
paper-jaamas/*.synctex.gz
paper-jaamas/*.spl
paper-jaamas/*.run.xml

# Publisher template packages, downloaded not authored
sn-template-extract/
*.zip

# The typeset manuscript is not published here.  The journals are told that no
# part of the paper has appeared before, and a downloadable PDF in a public
# repository is the one thing that could be read against that, so the built
# manuscript stays local while the code, data and figures that reproduce it
# stay public.  Remove these lines once the paper is accepted.
paper/main.pdf
paper-*/main.pdf
